[Unit]
Description=Kilix Secrets per-user vault daemon
Requires=kilix-secrets.socket
After=kilix-secrets.socket

[Service]
Type=simple
ExecStart=/usr/local/bin/kilix-secretsd --systemd --data-dir %h/.local/share/kilix-secrets
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=%h/.local/share/kilix-secrets
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
UMask=0077
